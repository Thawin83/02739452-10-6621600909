# Copy to .env:  cp .env.example .env

# --- Infrastructure ---
AIRFLOW_UID=50000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me

# --- Sources ---
